# Sao chép tệp này thành .env; `npm run dev` và `npm start` sẽ tự đọc tệp.
# Tạo OAuth client loại "Web application" trong Google Cloud Console.
# Authorized redirect URI phải là: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# localhost khi phát triển; dùng URL HTTPS thật khi triển khai.
APP_BASE_URL=http://127.0.0.1:3000

# Chuỗi ngẫu nhiên dài dùng để ký cookie phiên, ví dụ: openssl rand -hex 32
SESSION_SECRET=

# Tùy chọn
PORT=3000
# Node không tự đọc tệp này: hãy đặt các biến trong môi trường chạy ứng dụng.
# Tạo OAuth client loại "Web application" trong Google Cloud Console.
# Authorized redirect URI phải là: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# localhost khi phát triển; dùng URL HTTPS thật khi triển khai.
APP_BASE_URL=http://127.0.0.1:3000

# Chuỗi ngẫu nhiên dài dùng để ký cookie phiên, ví dụ: openssl rand -hex 32
SESSION_SECRET=

# Tùy chọn
PORT=3000

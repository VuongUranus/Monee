# Sao chép thành .env. Không commit file .env hoặc connection string thật.

# URL pooled (hostname có `-pooler`) chỉ dùng cho Fastify runtime.
DATABASE_URL=postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full

# URL direct (không có `-pooler`) chỉ dùng cho migration, import và verify.
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/DATABASE?sslmode=verify-full

# Google OAuth client loại "Web application".
# Authorized redirect URI: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://127.0.0.1:3000

# Ví dụ tạo secret: openssl rand -hex 32
SESSION_SECRET=

# Trợ lý tài chính Gemini. Chỉ bật với project paid tier khi dùng dữ liệu thật.
AI_ASSISTANT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_TIME_ZONE=Asia/Ho_Chi_Minh

PORT=3000

# Đặt HOST=0.0.0.0 khi deploy trên Railway hoặc PaaS tương tự.
# Bỏ trống khi chạy local để chỉ lắng nghe trên 127.0.0.1.
HOST=
